# .env.sample

# --- Seller Settings ---

# The wallet address that will receive payments. (Can be EVM or Solana)
PAY_TO_ADDRESS="YOUR_WALLET_ADDRESS_HERE"

# The blockchain network to use.
# Supported values: base, base-sepolia, solana-devnet
NETWORK="base-sepolia"

# The URL for the x402 facilitator service.
FACILITATOR_URL="https://facilitator.http402.xyz"


# --- Buyer Settings ---

# Private key of the wallet that will make payments.
# WARNING: Use a test/burner wallet only!
# (e.g., "0x..." for EVM, or a Base58 string for Solana)
PRIVATE_KEY="0xYOUR_TEST_WALLET_PRIVATE_KEY"


# --- Internal Communication Settings ---

# The base URL of this server itself, used for internal API calls.
# This should match the port the server is running on.
RESOURCE_SERVER_URL="http://localhost:8787"

# The specific path for the paid API endpoint.
# This should match the route defined in the server.
ENDPOINT_PATH="/api/weather"