# Dependencies
# ----------------------------------------------------------------
# Installed dependencies. These should be installed via `yarn install`.
/node_modules


# Build output
# ----------------------------------------------------------------
# Compiled JavaScript files from TypeScript.
/dist


# Environment variables
# ----------------------------------------------------------------
# This file contains sensitive information like your private key.
# It MUST NOT be committed to the repository for security reasons.
.env


# Logs
# ----------------------------------------------------------------
# Log files generated by package managers or applications.
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# Operating System generated files
# ----------------------------------------------------------------
.DS_Store
Thumbs.db


# Editor directories and files
# ----------------------------------------------------------------
# Configuration files for editors like VS Code.
.vscode/
.idea/

.README.md

